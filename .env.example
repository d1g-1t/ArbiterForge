# ---- Compose / порты (хост) -----------------------------------------------
COMPOSE_PROJECT_NAME=arbiterforge
API_HOST_PORT=20100
POSTGRES_HOST_PORT=20101
REDIS_HOST_PORT=20102

# ---- Postgres / Redis -----------------------------------------------------
POSTGRES_USER=arbiterforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arbiterforge
REDIS_PASSWORD=change-me

# ---- Приложение -----------------------------------------------------------
ARBITERFORGE_ENV=dev
ARBITERFORGE_DATABASE_URL=postgresql+asyncpg://arbiterforge:change-me@postgres:5432/arbiterforge
ARBITERFORGE_REDIS_URL=redis://:change-me@redis:6379/0
ARBITERFORGE_TOKEN_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ARBITERFORGE_AUDIT_HMAC_SECRET=change-me-to-another-long-random-string-32chars
ARBITERFORGE_ACCESS_TOKEN_TTL_MINUTES=60
ARBITERFORGE_OLLAMA_BASE_URL=http://host.docker.internal:11434
ARBITERFORGE_OLLAMA_MODEL=qwen2.5:7b
ARBITERFORGE_CORS_ALLOW_ORIGINS=http://127.0.0.1:20100
ARBITERFORGE_LOG_JSON=true
ARBITERFORGE_LOG_MASKING=true

# ---- Тесты ----------------------------------------------------------------
ARBITERFORGE_TEST_DATABASE_URL=postgresql+asyncpg://arbiterforge:change-me@postgres:5432/arbiterforge_test
ARBITERFORGE_TEST_REDIS_URL=redis://:change-me@redis:6379/1
